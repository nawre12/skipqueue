<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ProfilActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/profil_spacing_large">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_avatar"
            android:layout_width="@dimen/profil_avatar_size"
            android:layout_height="@dimen/profil_avatar_size"
            android:layout_marginTop="@dimen/profil_spacing_large"
            android:background="?attr/colorSurfaceVariant"
            android:contentDescription="@string/profil_avatar_desc"
            android:padding="@dimen/profil_avatar_padding"
            android:src="@drawable/ic_avatar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Circle" />

        <TextView
            android:id="@+id/tv_nom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/profil_spacing_medium"
            android:text="@string/profil_nom_invite"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="?attr/colorOnSurface"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_avatar" />

        <TextView
            android:id="@+id/tv_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/profil_spacing_small"
            android:text="@string/profil_email_placeholder"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_nom" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_statut"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/profil_spacing_medium"
            android:clickable="false"
            android:text="@string/profil_statut_invite"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_email"
            app:layout_goneMarginTop="@dimen/profil_spacing_medium" />

        <!-- Carte d'invitation (à plat) : fond + texte + bouton + espace -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_invitation"
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/profil_spacing_medium"
            android:layout_marginTop="@dimen/profil_spacing_large"
            android:layout_marginEnd="@dimen/profil_spacing_medium"
            app:layout_constraintBottom_toBottomOf="@id/space_invitation"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/chip_statut" />

        <TextView
            android:id="@+id/tv_invitation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/profil_spacing_medium"
            android:layout_marginTop="@dimen/profil_spacing_medium"
            android:layout_marginEnd="@dimen/profil_spacing_medium"
            android:text="@string/profil_invitation_message"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurface"
            app:layout_constraintEnd_toEndOf="@id/card_invitation"
            app:layout_constraintStart_toStartOf="@id/card_invitation"
            app:layout_constraintTop_toTopOf="@id/card_invitation" />

        <Button
            android:id="@+id/btn_creer_compte"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/profil_spacing_medium"
            android:layout_marginTop="@dimen/profil_spacing_medium"
            android:layout_marginEnd="@dimen/profil_spacing_medium"
            android:text="@string/profil_btn_creer_compte"
            app:layout_constraintEnd_toEndOf="@id/card_invitation"
            app:layout_constraintStart_toStartOf="@id/card_invitation"
            app:layout_constraintTop_toBottomOf="@id/tv_invitation" />

        <Space
            android:id="@+id/space_invitation"
            android:layout_width="0dp"
            android:layout_height="@dimen/profil_spacing_medium"
            app:layout_constraintEnd_toEndOf="@id/card_invitation"
            app:layout_constraintStart_toStartOf="@id/card_invitation"
            app:layout_constraintTop_toBottomOf="@id/btn_creer_compte" />

        <androidx.constraintlayout.widget.Group
            android:id="@+id/group_invitation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="card_invitation,tv_invitation,btn_creer_compte,space_invitation" />

        <!-- Liste d'options -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_commandes"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/profil_spacing_medium"
            android:layout_marginTop="@dimen/profil_spacing_large"
            android:layout_marginEnd="@dimen/profil_spacing_medium"
            android:gravity="start|center_vertical"
            android:minHeight="@dimen/profil_option_height"
            android:text="@string/profil_option_commandes"
            android:textColor="?attr/colorOnSurface"
            app:icon="@drawable/ic_orders"
            app:iconTint="?attr/colorOnSurface"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_invitation"
            app:layout_goneMarginTop="@dimen/profil_spacing_large" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_favoris"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/profil_spacing_medium"
            android:layout_marginEnd="@dimen/profil_spacing_medium"
            android:gravity="start|center_vertical"
            android:minHeight="@dimen/profil_option_height"
            android:text="@string/profil_option_favoris"
            android:textColor="?attr/colorOnSurface"
            app:icon="@drawable/ic_favorite"
            app:iconTint="?attr/colorOnSurface"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_commandes" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_parametres"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/profil_spacing_medium"
            android:layout_marginEnd="@dimen/profil_spacing_medium"
            android:gravity="start|center_vertical"
            android:minHeight="@dimen/profil_option_height"
            android:text="@string/profil_option_parametres"
            android:textColor="?attr/colorOnSurface"
            app:icon="@drawable/ic_settings"
            app:iconTint="?attr/colorOnSurface"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_favoris"
            app:layout_goneMarginTop="@dimen/profil_spacing_large" />

        <Button
            android:id="@+id/btn_deconnexion"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/profil_spacing_medium"
            android:layout_marginTop="@dimen/profil_spacing_large"
            android:layout_marginEnd="@dimen/profil_spacing_medium"
            android:text="@string/profil_btn_deconnexion"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_parametres" />

        <Button
            android:id="@+id/btn_supprimer"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/profil_spacing_medium"
            android:layout_marginTop="@dimen/profil_spacing_small"
            android:layout_marginEnd="@dimen/profil_spacing_medium"
            android:text="@string/profil_btn_supprimer"
            android:textColor="?attr/colorError"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_deconnexion" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>